# Hanjo ERP Environment Configuration Example
APP_NAME=hanjo
APP_VERSION=0.1.0
APP_ENV=development
APP_DEBUG=true

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=hanjo
DB_PASSWORD=hanjo_secret
DB_NAME=hanjo_db
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_MAX_LIFETIME_MINUTES=5

# JWT
JWT_SECRET=change-this-to-a-random-secret-key
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_HOURS=168
JWT_ISSUER=hanjo

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT_SECONDS=15
SERVER_WRITE_TIMEOUT_SECONDS=15
SERVER_IDLE_TIMEOUT_SECONDS=60
